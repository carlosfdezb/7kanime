# AnimeAV1 Front (Lite) — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Only one variable is read at build time. The front bundles VITE_* values
# into the static output, so changing this requires a rebuild (`npm run build`).

# Base URL of the lite backend. Defaults to same host on port 3000 when unset.
# Examples:
#   VITE_API_BASE=http://localhost:3000
#   VITE_API_BASE=https://anime.tu-dominio.com
VITE_API_BASE=
